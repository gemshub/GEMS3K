# Recommended cmake macro use to write a cmake config file.
@PACKAGE_INIT@

# Ensure dependencies from the conda environment are used (e.g., Boost).
list(APPEND CMAKE_PREFIX_PATH $ENV{CONDA_PREFIX})

# A package can install its own Optima in a folder of its own (GEMS3K_OPTIMA_SUBDIR). Set before the includes below.
set(_gems3k_optima_dir "${PACKAGE_PREFIX_DIR}/@GEMS3K_OPTIMA_SUBDIR@/@CMAKE_INSTALL_LIBDIR@/cmake/Optima")

# Include the cmake targets of the project if they have not been yet.
if(NOT TARGET GEMS3K::GEMS3K)
    include("@PACKAGE_GEMS3K_INSTALL_CONFIGDIR@/GEMS3KTargets.cmake")
endif()

# Optima::Optima is a public dependency of the exported targets when built with it.
# After the include above: Optima's own dependencies reset PACKAGE_PREFIX_DIR.
if(@USE_OPTIMA_SOLVER@)
    include(CMakeFindDependencyMacro)
    # Use the package's own Optima first.
    if(NOT "@GEMS3K_OPTIMA_SUBDIR@" STREQUAL "" AND EXISTS "${_gems3k_optima_dir}/OptimaConfig.cmake")
        # Optima_DIR is set first: find_dependency() uses an Optima_DIR from the cache before PATHS.
        set(Optima_DIR "${_gems3k_optima_dir}")
        find_dependency(Optima PATHS "${_gems3k_optima_dir}" NO_DEFAULT_PATH)
    else()
        find_dependency(Optima)
    endif()
endif()

# Recommended check at the end of a cmake config file.
check_required_components(GEMS3K)
